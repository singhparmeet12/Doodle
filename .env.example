# Scribbleverse Environment Configuration

# Security
SECRET_KEY=change-this-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Leave unset for SQLite, or provide Postgres URL for production)
# DATABASE_URL=postgres://user:password@localhost:5432/scribbleverse_db

# CSRF Trusted Origins (comma-separated, include https://yourdomain.com for production)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security overrides for production (set to True when deploying with SSL)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
